				{
					"name": "Kullanıcı Giriş (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.access_token) {",
									"    if (jsonData.role === 'super_admin') {",
									"        pm.collectionVariables.set('super_admin_token', jsonData.access_token);",
									"    } else {",
									"        pm.collectionVariables.set('admin_token', jsonData.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin1@sirket.com\",\n    \"password\": \"sifre123\"\n}",
